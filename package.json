{
  "name": "poc-graph-expansion",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "engines": {
    "node": ">=24.20.0"
  },
  "description": "React 16 POC comparing eight graph rendering libraries side by side on one shared graph",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,css}\"",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@jsplumb/browser-ui": "^6.2.10",
    "@neo4j-nvl/base": "^1.2.1",
    "@neo4j-nvl/interaction-handlers": "^1.2.1",
    "@neo4j-nvl/react": "1.2.1",
    "@xyflow/react": "12.11.6",
    "cytoscape": "^3.34.2",
    "d3-force": "^3.0.0",
    "echarts": "^6.1.0",
    "fusioncharts": "^4.2.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "v-network-graph": "^0.9.23",
    "vis-network": "^10.1.2",
    "vue": "^3.5.42"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/d3-force": "3.0.10",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
